---
import { DocsSidebar } from '@oimlsmart/site-shell'
import { getCollection } from 'astro:content'
import Shell from '../../layouts/Shell.astro'

const chapters = (await getCollection('docs'))
  .filter(d => d.id.startsWith('sst/'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
---

<Shell title="Documentation" description="The SMI Simulation documentation.">
  <div class="max-w-7xl mx-auto px-6 py-10 grid gap-10 lg:grid-cols-[16rem_1fr]">
    <aside><DocsSidebar order={['sst']} labels={{ 'sst': 'SMI Simulation' }} hrefBase="/sst/docs/" /></aside>
    <main class="docs-body">
      <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3">SMI Simulation · Docs</p>
      <h1 class="font-serif text-3xl font-semibold text-ink mb-6">The SMI Simulation documentation</h1>
      <p class="text-ink-soft mb-6">What a Simulated SMART Measuring Instrument Twin is, how to boot one, and how a test run drives it. Start with the overview, then the chapters in order.</p>
      <ul class="mt-4 space-y-3">
        {chapters.map(d => (
          <li><a class="text-accent font-medium" href={`/sst/docs/${d.id}`}>{d.data.shortTitle ?? d.data.title ?? d.id.split('/').pop()}</a>{d.data.description ? <span class="text-ink-soft"> — {d.data.description}</span> : null}</li>
        ))}
      </ul>
    </main>
  </div>
</Shell>
